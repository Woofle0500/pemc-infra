# Terraform state - contains secrets
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local state lock
.terraform.tfstate.lock.info

# Provider binaries and module cache
.terraform/

# Variable files - often contain account IDs, sometimes secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Backend config files - local -backend-config overrides (e.g. AWS profile)
*-backend-config.hcl

# Plan files — full topology in binary form
*.tfplan
plan.out
tfplan*

# Crash logs
crash.log
crash.*.log

# Files containing sensitive information
.env
*.pem
*.key
credentials
docs/naming.md

# IDEs and Editors
.vscode/
.claude/
.idea/
*.swp
*.swo
.envrc

# OS Files
.DS_Store
Thumbs.db

# Python files
__pycache__
*venv*